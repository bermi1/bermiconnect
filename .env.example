# ---------- Bermi Connect ----------
NODE_ENV=development

# Postgres (used by docker-compose's postgres service)
POSTGRES_USER=bermi
POSTGRES_PASSWORD=bermi
POSTGRES_DB=bermi_connect

# Backend API
PORT=4000
DATABASE_URL=postgres://bermi:bermi@localhost:5432/bermi_connect
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
APP_URL=http://localhost:5173
# Comma-separated allowed browser origins, or * for any
CORS_ORIGINS=http://localhost:5173
# Comma-separated emails of platform admins (approve sender IDs, credit accounts)
ADMIN_EMAILS=admin@bermiconnect.co.tz
LOG_LEVEL=info

# SMS route
SMS_PROVIDER=textify_smpp          # textify_smpp | log (log = print only)
TEXTIFY_SMPP_HOST=localhost
TEXTIFY_SMPP_PORT=2775
TEXTIFY_SMPP_SYSTEM_ID=bermi
TEXTIFY_SMPP_PASSWORD=secret
TEXTIFY_SMPP_SYSTEM_TYPE=
TEXTIFY_SMPP_TLS=false
TEXTIFY_SMPP_TPS=50                # throttle messages/sec
TEXTIFY_SMPP_ENQUIRE_LINK_MS=30000

# Pricing & defaults
SMS_PRICE_TZS=18                   # price per SMS segment charged to customers
DEFAULT_SENDER_ID=BERMI
SIGNUP_FREE_CREDIT_TZS=500

# Developer API
API_RATE_LIMIT_PER_MIN=100         # per API key
# Shared secret for POST /v1/inbound/textify (?token= or X-Inbound-Token). Empty = no check.
INBOUND_WEBHOOK_TOKEN=
WORKER_CONCURRENCY=20

# Frontend (Vite)
VITE_API_URL=http://localhost:4000/v1
VITE_DOCS_URL=http://localhost:8080

# Textify HTTP API (sender names, backup send route). Real key goes only in backend/.env
TEXTIFY_API_URL=https://portal.textify.africa/api/v1
TEXTIFY_API_KEY=txf_your_key_here
